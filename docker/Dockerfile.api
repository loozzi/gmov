# syntax=docker/dockerfile:1
# ---- builder: resolve deps with uv into a venv ----
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /app
RUN pip install --no-cache-dir "uv>=0.4"

COPY apps/api/pyproject.toml apps/api/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# ---- runtime: venv + source only, non-root ----
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    UVICORN_WORKERS=2

WORKDIR /app
RUN useradd -m appuser && chown appuser:appuser /app
COPY --from=builder /app/.venv /app/.venv
COPY apps/api/app ./app
COPY apps/api/alembic.ini ./alembic.ini
COPY --chmod=755 docker/entrypoint-api.sh ./entrypoint.sh
RUN chown -R appuser:appuser /app

USER appuser
EXPOSE 8000
ENTRYPOINT ["./entrypoint.sh"]
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-2}"]
HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=20s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
