# syntax=docker/dockerfile:1
# ---- deps: install workspace deps with pnpm ----
FROM node:22-alpine AS deps

RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile

# ---- builder: Next.js standalone build ----
FROM node:22-alpine AS builder

RUN corepack enable
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY package.json pnpm-workspace.yaml ./
COPY apps/web ./apps/web
# No NEXT_PUBLIC_* API base: the browser only calls the same origin and
# /api/v1/* is proxied server-side (see app/api/v1/[...path]/route.ts).
RUN pnpm --filter gmov-web build

# ---- runner: minimal standalone server, non-root ----
FROM node:22-alpine AS runner

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
RUN mkdir -p /app/apps/web/.next/cache && chown -R appuser:appgroup /app

USER appuser
EXPOSE 3000
ENV PORT=3000 HOSTNAME="0.0.0.0"
HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=20s \
  CMD node -e "fetch('http://localhost:3000/').then(r => { if (!r.ok) process.exit(1) })"
CMD ["node", "apps/web/server.js"]
