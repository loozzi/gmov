# Copy to .env for local dev. NEVER commit .env (it is gitignored).
# docker-compose.yml has safe defaults for everything, so .env is optional.

# --- Postgres ---
POSTGRES_USER=gmov
POSTGRES_PASSWORD=change-me-dev-password
POSTGRES_DB=gmov
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://gmov:change-me-dev-password@localhost:5432/gmov
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000
NGUONC_BASE_URL=https://phim.nguonc.com/api
NGUONC_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=3600

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://api:8000
